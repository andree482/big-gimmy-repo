// Componente per il filtro dei prodotti
const ProductFilters = ({ 
  selectedBrands, 
  setSelectedBrands,
  brands
}: { 
  selectedBrands: string[],
  setSelectedBrands: (brands: string[]) => void,
  brands: string[]
}) => {
  const toggleBrand = (brand: string) => {
    if (selectedBrands.includes(brand)) {
      setSelectedBrands(selectedBrands.filter(b => b !== brand));
    } else {
      setSelectedBrands([...selectedBrands, brand]);
    }
  };
  
  return (
    <div className="mb-8 bg-white p-4 rounded-lg shadow-sm border border-gray-200">
      <h3 className="font-bold text-lg mb-3">Filtra per Marca</h3>
      <div className="space-y-2">
        {brands.map(brand => (
          <label key={brand} className="flex items-center cursor-pointer">
            <input
              type="checkbox"
              checked={selectedBrands.includes(brand)}
              onChange={() => toggleBrand(brand)}
              className="mr-2"
            />
            <span>{brand}</span>
          </label>
        ))}
      </div>
    </div>
  );
};

// Componente principale per la categoria prodotti
const ProductCategory = () => {
  const params = useParams<{ category: string }>();
  
  const category = params.category ? 
    productCategories.find(c => {
      const slug = c.title.toLowerCase()
        .replace(/\s+/g, '-')
        .replace(/[àáâãäå]/g, 'a')
        .replace(/[èéêë]/g, 'e')
        .replace(/[ìíîï]/g, 'i')
        .replace(/[òóôõö]/g, 'o')
        .replace(/[ùúûü]/g, 'u');
      return slug === params.category?.toLowerCase();
    }) : null;
  
  const [selectedBrands, setSelectedBrands] = useState<string[]>([]);
  
  // Carica i prodotti dal database tramite API
  const { data: dbProducts = [], isLoading } = useQuery({
    queryKey: ['products', params.category],
    queryFn: async () => {
      const response = await fetch(`/api/products/${params.category}`);
      if (!response.ok) return [];
      return response.json();
    },
    enabled: !!params.category
  });

  // Carica i prodotti per categoria (fallback per categorie non nel database)
  const getCategoryProducts = (categoryName: string): Product[] => {
    // Carica i prodotti statici esistenti
    let staticProducts: Product[] = [];
    switch (categoryName.toLowerCase()) {
      case 'proteine':
        staticProducts = proteinProducts;
        break;
      case 'aminoacidi':
        staticProducts = aminoacidProducts;
        break;
      default:
        staticProducts = [];
    }

    // Aggiungi i prodotti dal database se disponibili
    if (dbProducts && dbProducts.length > 0) {
      const newProducts = dbProducts.map((dbProduct: any) => {
        // Mappatura delle immagini per ogni prodotto
        const getProductImages = (slug: string) => {
          const imageMap: { [key: string]: string } = {
            // Proteine
            "protein-wafer-low-sugar": "PROTEIN WAFER LOW SUGAR_Cacao_Fronte.jpg",
            "protein-white-31": "Protein+ white crema limone FRONTE.jpg",
            "soy-protein-221": "SAY PROTEIN 221 CACAO fronte.jpg",
            "protein-classic-25": "Protein+ classic_banana_fronte.jpg",
            "light-protein-bar": "LIGHT PROTEIN BAR CARAMELLO Fronte.jpg",
            "smart-protein-cacao": "SMART PROTEIN_CACAO_Fronte.jpg",
            "protein-evo-barrette": "Protein+ EVO cocco FRONTE.jpg",
            
            // Vitamine e Minerali
            "antiradical-mix-plus": "Antiradical mix+ 60 capsule q FRONTE.jpg",
            "ashwagandha-pura": "ASHWAGANDHA PURA_Fronte.jpg",
            "astaxantina-softgel": "ASTAXANTINA SOFTGEL_FRONTE.jpg",
            "cla-plus": "ADVANCE CLA_FRONTE.jpg",
            "depur-nac": "ADVANCE DEPUR NAC_FRONTE.jpg",
            "bromelina-plus": "Bromelina_Fronte.jpg",
            "b-strong": "B STRONG_Fronte.jpg",
            "collagene-plus": "Collagene_Fronte.jpg",
            "comfort-vision": "Comfort Vision_Fronte.jpg",
            "berberina-plus": "BERBERINA 60 CAPSULE_FRONTE.jpg",
            "dretox-plus": "DRETOX 450ML_FRONTE.jpg",
            "d-ribosio": "D RIBOSIO_Fronte.jpg",
            "electrolyte": "ELECTROLYTE_Arancia_Fronte.jpg",
            "energy-pump": "ENERGY PUMP_Limone_Fronte.jpg",
            "enziplus": "ENZIPLUS CAPSULE fronte.jpg",
            "ferro": "FERRO_Ribes_Fronte.jpg",
            "fluid-cramp": "FLUID CRAMP_Arancia_Fronte.jpg"
          };
          
          return [{
            src: `/images/${imageMap[slug] || 'placeholder.jpg'}`,
            alt: dbProduct.name,
            primary: true
          }];
        };

        // Mappatura dei gusti per ogni prodotto
        const getProductFlavors = (slug: string) => {
          switch (slug) {
            case "protein-wafer-low-sugar":
              return [{ name: "Cacao" }, { name: "Vaniglia" }];
            case "protein-white-31":
              return [{ name: "Crema Limone" }, { name: "Tiramisu" }, { name: "Vaniglia" }];
            case "soy-protein-221":
              return [{ name: "Cacao" }, { name: "Nocciola" }];
            case "protein-classic-25":
              return [{ name: "Banana" }, { name: "Cacao" }, { name: "Cocco" }, { name: "Yogurt Fragola" }];
            case "light-protein-bar":
              return [{ name: "Caramello Salato" }, { name: "Cheesecake" }];
            case "smart-protein-cacao":
              return [{ name: "Cacao" }];
            case "protein-evo-barrette":
              return [{ name: "Cocco" }, { name: "Crème Caramel" }];
            default:
              return [];
          }
        };

        return {
          id: dbProduct.slug,
          name: dbProduct.name,
          description: dbProduct.description,
          images: getProductImages(dbProduct.slug),
          basePrice: 25.99,
          rating: 0,
          reviewCount: 0,
          sizes: [{ 
            value: "1", 
            unit: "confezione", 
            price: 25.99,
            priceRange: "€25.99"
          }],
          flavors: getProductFlavors(dbProduct.slug),
          category: categoryName,
          brand: dbProduct.brandId === 1 ? "+WATT" : "Vegetal +WATT",
          inStock: true,
          nutritionalValues: {
            calories: "150 kcal",
            protein: "15g",
            carbs: "12g",
            fat: "6g"
          },
          isBestSeller: dbProduct.isBestSeller || false,
          isNew: dbProduct.isNew || false,
          specialOfferText: dbProduct.specialOfferText || null
        };
      });
      
      // Combina prodotti esistenti con quelli nuovi
      return [...staticProducts, ...newProducts];
    }

    return staticProducts;
  };

  const allProducts = category ? getCategoryProducts(category.title) : [];
  
  // Filtra i prodotti per categoria
  const products = allProducts.filter(product => {
    if (selectedBrands.length === 0) return true;
    return selectedBrands.includes(product.brand);
  });
  
  // Estrai le marche disponibili per questa categoria
  const brands = Array.from(new Set(allProducts.map(p => p.brand)));
  
  if (!category) {
    return (
      <div className="min-h-screen flex items-center justify-center">
        <div className="text-center">
          <h1 className="text-2xl font-bold mb-4">Categoria non trovata</h1>
          <p className="text-gray-600 mb-4">Categoria richiesta: {params.category}</p>
          <p className="text-gray-600">Categorie disponibili: {productCategories.map(c => c.title).join(", ")}</p>
          <Link href="/prodotti" className="text-[#FFD100] hover:underline mt-4 inline-block">
            Torna ai prodotti
          </Link>
        </div>
      </div>
    );
  }
  
  return (
    <div className="min-h-screen">
      {/* Hero Section */}
      <section className="bg-[#212121] text-white py-20">
        <div className="container mx-auto px-4 text-center">
          <h1 className="text-4xl md:text-5xl font-montserrat font-bold mb-6">
            <span className="text-[#FFD100]">{category.title}</span>
          </h1>
          <p className="max-w-3xl mx-auto text-lg">
            {category.description}
          </p>
        </div>
      </section>
      
      {/* Main Content */}
      <section className="py-12">
        <div className="container mx-auto px-4">
          {/* Custom Benefits Banner */}
          <div className="bg-[#FFD100] text-black p-6 rounded-lg mb-8">
            <div className="flex flex-wrap justify-between items-center">
              <h2 className="text-2xl font-bold mb-4 md:mb-0">Vantaggi Esclusivi</h2>
              <div className="grid grid-cols-1 md:grid-cols-3 gap-4 w-full md:w-auto">
                <div className="flex items-center">
                  <Check className="h-5 w-5 mr-2" />
                  <span className="font-semibold">Consulenza personalizzata</span>
                </div>
                <div className="flex items-center">
                  <Check className="h-5 w-5 mr-2" />
                  <span className="font-semibold">Prodotti originali garantiti</span>
                </div>
                <div className="flex items-center">
                  <Check className="h-5 w-5 mr-2" />
                  <span className="font-semibold">Staff qualificato</span>
                </div>
              </div>
            </div>
          </div>
          
          <div className="flex flex-col md:flex-row gap-8">
            {/* Sidebar with filters */}
            <div className="w-full md:w-1/4">
              <ProductFilters 
                selectedBrands={selectedBrands}
                setSelectedBrands={setSelectedBrands}
                brands={brands}
              />
              
              <WhyBuyFromUs />
              
              <div className="bg-white p-4 rounded-lg shadow-sm border border-gray-200 mb-8">
                <h3 className="font-bold text-lg mb-3">Hai bisogno di aiuto?</h3>
                <p className="text-sm mb-4">Non sei sicuro di quale prodotto scegliere? Il nostro team di esperti è a tua disposizione!</p>
                <Link href="/contatti">
                  <button className="w-full bg-[#212121] hover:bg-black text-white px-4 py-2 rounded-md text-sm font-semibold transition-colors">
                    Contattaci
                  </button>
                </Link>
              </div>
            </div>
            
            {/* Main products grid */}
            <div className="w-full md:w-3/4">
              {products.length > 0 ? (
                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
                  {products.map(product => (
                    <ProductCard key={product.id} product={product} />
                  ))}
                </div>
              ) : (
                <div className="bg-white p-8 rounded-lg shadow-sm border border-gray-200 mb-12 text-center">
                  <h3 className="text-2xl font-bold mb-4">Prodotti in arrivo</h3>
                  <p className="text-gray-600 mb-6">Stiamo aggiornando il nostro catalogo prodotti. Torna presto per scoprire la nostra selezione di integratori di altissima qualità.</p>
                  <Link href="/contatti">
                    <button className="bg-[#FFD100] hover:bg-yellow-400 text-black px-6 py-3 rounded-md font-semibold transition-colors">
                      Contattaci per informazioni
                    </button>
                  </Link>
                </div>
              )}
              
              {/* Rimuoviamo temporaneamente le sezioni specifiche */}
              {/* <ProductFAQ /> */}
              {/* <CustomerTestimonials /> */}
            </div>
          </div>
        </div>
      </section>
    </div>
  );
};

export default ProductCategory;