          <Link href={`/prodotti/proteine/${product.slug || product.id}`}>
            <button className="bg-[#FFD100] hover:bg-yellow-400 text-black px-4 py-2 rounded-md text-sm font-semibold transition-colors">
              Vedi Dettagli
            </button>
          </Link>
        </div>
      </div>
    </div>
  );
};

// Componente per la sezione FAQ
const ProductFAQ = () => {
  const [openQuestion, setOpenQuestion] = useState<number | null>(null);
  
  const toggleQuestion = (index: number) => {
    setOpenQuestion(openQuestion === index ? null : index);
  };
  
  const faqs = [
    {
      question: "Qual è la differenza tra proteine isolate e concentrate?",
      answer: "Le proteine isolate contengono una percentuale proteica più alta (90-95%) rispetto alle concentrate (80-85%) e hanno meno grassi e carboidrati. Le isolate sono ideali per chi segue diete a basso contenuto di grassi o per chi ha lievi intolleranze al lattosio. Le concentrate invece hanno un prezzo più accessibile e contengono più nutrienti naturalmente presenti nel siero del latte."
    },
    {
      question: "Quando è meglio assumere le proteine in polvere?",
      answer: "Il momento migliore dipende dagli obiettivi personali. Per la crescita muscolare, è ottimale assumerle entro 30-60 minuti dopo l'allenamento per massimizzare la sintesi proteica. Possono essere assunte anche come spuntino proteico durante la giornata o a colazione. Se l'obiettivo è prevenire il catabolismo notturno, una proteina a rilascio lento come la caseina è ideale prima di dormire."
    },
    {
      question: "Le proteine in polvere possono sostituire quelle alimentari?",
      answer: "Le proteine in polvere sono un'integrazione, non un sostituto delle proteine alimentari. Gli alimenti integrali contengono vitamine, minerali e altri nutrienti non presenti negli integratori. Tuttavia, le proteine in polvere offrono convenienza, digeribilità e un profilo aminoacidico ottimale, rendendole un'ottima aggiunta a una dieta equilibrata, soprattutto per chi ha difficoltà a raggiungere il fabbisogno proteico quotidiano."
    },
    {
      question: "Come scegliere il prodotto giusto per i miei obiettivi?",
      answer: "La scelta dipende dai tuoi obiettivi specifici. Per aumento massa, le proteine con un buon rapporto proteine/carboidrati sono ideali. Per definizione o dimagrimento, proteine isolate a basso contenuto di grassi e carboidrati. Per vegani, proteine vegetali come pisello, riso o soia. Consigliamo sempre di venire in negozio per una consulenza personalizzata, dove valuteremo insieme obiettivi, dieta attuale, eventuali intolleranze e livello di attività fisica."
    }
  ];
  
  return (
    <div className="mt-12">
      <h3 className="text-2xl font-bold mb-4">Domande Frequenti sulle Proteine</h3>
      <div className="space-y-4">
        {faqs.map((faq, index) => (
          <div key={index} className="border border-gray-200 rounded-lg overflow-hidden">
            <button
              className="w-full px-6 py-4 text-left font-semibold flex items-center justify-between bg-gray-50 hover:bg-gray-100"
              onClick={() => toggleQuestion(index)}
            >
              {faq.question}
              {openQuestion === index ? (
                <ChevronUp className="h-5 w-5 text-gray-500" />
              ) : (
                <ChevronDown className="h-5 w-5 text-gray-500" />
              )}
            </button>
            
            {openQuestion === index && (
              <div className="px-6 py-4 bg-white">
                <p className="text-gray-600">{faq.answer}</p>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  );
};

